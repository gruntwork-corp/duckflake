# name: test/sql/types/number.test
# description: Snowflake NUMBER [ (precision [, scale]) ]
# group: [types]

statement error
SELECT 1::NUMBER;
----
<REGEX>:Catalog Error:.*Type with name NUMBER does not exist.*

require duckflake

# Defaults to (38, 0); scale defaults to 0
query TTT
SELECT typeof(1::NUMBER), typeof(1::NUMBER(10)), typeof(1::NUMBER(10, 2));
----
DECIMAL(38,0)	DECIMAL(10,0)	DECIMAL(10,2)

query TT
SELECT typeof(CAST('7' AS number)), typeof(1::Number(38, 38));
----
DECIMAL(38,0)	DECIMAL(38,38)

# Casting rounds to the scale
query TTT
SELECT 1.5::NUMBER, 1.25::NUMBER(10, 1), -2.5::NUMBER;
----
2	1.3	-3

# The full 38 digits fit
query T
SELECT '12345678901234567890123456789012345678'::NUMBER;
----
12345678901234567890123456789012345678

statement ok
CREATE TABLE t (a NUMBER, b NUMBER(12, 4), c number(5));

query TT
SELECT column_name, column_type FROM (DESCRIBE t) ORDER BY column_name;
----
a	DECIMAL(38,0)
b	DECIMAL(12,4)
c	DECIMAL(5,0)

statement ok
INSERT INTO t VALUES (10, 1.23456, 99999);

query TTT
SELECT * FROM t;
----
10	1.2346	99999

statement error
INSERT INTO t VALUES (1, 1, 100000);
----
<REGEX>:Conversion Error:.*

statement error
SELECT 1::NUMBER(39);
----
<REGEX>:Binder Error:.*NUMBER precision must be between 1 and 38.*

statement error
SELECT 1::NUMBER(0);
----
<REGEX>:Binder Error:.*NUMBER precision must be between 1 and 38.*

statement error
SELECT 1::NUMBER(5, 6);
----
<REGEX>:Binder Error:.*NUMBER scale cannot be greater than its precision.*

# DuckDB's own DECIMAL keeps its default
query T
SELECT typeof(1::DECIMAL);
----
DECIMAL(18,3)
